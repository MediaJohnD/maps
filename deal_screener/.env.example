# Required for LLM-based parsing (paste-text and screenshot upload).
# Without this, parsing falls back to regex-only extraction and every
# field regex can't reach (address, rent estimate, tax/insurance/HOA,
# condition notes) is left blank for manual entry.
ANTHROPIC_API_KEY=

# Optional overrides — sensible defaults are used if unset.
# DEAL_SCREENER_DB_PATH=deal_screener.db
# DEAL_SCREENER_PMMS_CACHE=pmms_rate_cache.json
# DEAL_SCREENER_MODEL=claude-sonnet-4-6
